/*
 * Shared config applied to every package-provider nf-test (via nf-test.config
 * `configFile`). Enables the preview feature and loads all provider plugins;
 * each test exercises only its tagged provider, so a CI job needs just that one
 * tool installed.
 */

nextflow.preview.package = true

plugins {
    id 'nf-conda'
    id 'nf-pixi'
    id 'nf-uv'
    id 'nf-pak'
    id 'nf-install2r'
}

packages {
    provider = 'conda'
    conda {
        channels = ['conda-forge', 'bioconda']
    }
}
